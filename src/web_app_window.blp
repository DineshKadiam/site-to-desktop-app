using Gtk 4.0;
using Adw 1;

template $WebAppWindow : Adw.ApplicationWindow {
  default-width: 800;
  default-height: 600;

  content: Adw.ToolbarView toolbar {
    [top]
    Adw.HeaderBar headerbar {
      [start]
      Gtk.Button back_button {
        tooltip-text: _("Back");
        icon-name: "go-previous-symbolic";
        sensitive: false;
        styles ["flat"]
      }

      [start]
      Gtk.Button forward_button {
        tooltip-text: _("Forward");
        icon-name: "go-next-symbolic";
        sensitive: false;
        styles ["flat"]
      }

      [start]
      Gtk.Button reload_button {
        tooltip-text: _("Reload");
        icon-name: "view-refresh-symbolic";
        styles ["flat"]
      }

      [end]
      Gtk.Button hide_button {
        tooltip-text: _("Send to Background");
        icon-name: "background-app-symbolic";
        styles ["flat"]
      }
    }

    content: Gtk.Box {
      orientation: vertical;

      Gtk.Overlay {
        Adw.ToastOverlay toast_overlay {
          // WebView will be added here in code
        }

        [overlay]
        Gtk.ProgressBar progressbar {
          valign: start;
          styles ["osd"]
        }
      }
    };
  };
}
